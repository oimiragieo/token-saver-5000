# Token Saver 5000 — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── MCP Server Profile ───────────────────────────────────────────────────────
# Select tool set to expose: "full" (all 49), "core" (compression only), or "minimal"
MCP_TOOL_PROFILE=full

# ─── Embedding Model Loading ──────────────────────────────────────────────────
# Set to "true" to preload the CodeBERT model at startup (~400MB) instead of lazy loading.
# Default: false (lazy load on first use, saves ~400MB startup memory)
PRELOAD_CODE_MODEL=false

# ─── HTTP Server ──────────────────────────────────────────────────────────────
# Enable the optional aiohttp HTTP server alongside stdio MCP transport.
# Required for Kubernetes health probes. Default: false (stdio-only mode).
HTTP_ENABLED=false
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Health check result caching to avoid expensive checks on every request.
HEALTH_CHECK_CACHE_SECONDS=10

# ─── Environment / Deployment ─────────────────────────────────────────────────
# Affects log verbosity (DEBUG sampling) and OTel sampling rates.
# Values: "development" | "staging" | "production"
ENVIRONMENT=development

# ─── ACE Context Limits ───────────────────────────────────────────────────────
# Maximum number of ACE (Agentic Context Engineering) contexts held in memory.
# Each context is ~70KB. 100 contexts ≈ 7MB. Default: 100
MAX_ACE_CONTEXTS=100

# ─── Document Size Limits ─────────────────────────────────────────────────────
# Maximum document size accepted by ingest tools.
MAX_DOCUMENT_SIZE_MB=10
MAX_TEXT_LENGTH_BYTES=10485760

# ─── OpenTelemetry ────────────────────────────────────────────────────────────
# Trace sampling rate. 1.0 = 100% (development), 0.1 = 10% (production).
OTEL_SAMPLING_RATE=1.0

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Requests per second limits for batch and compression endpoints.
RATE_LIMIT_BATCH=10
RATE_LIMIT_COMPRESSION=20
RATE_LIMIT_INGEST=5

# ─── Optional Integrations ────────────────────────────────────────────────────
# GitHub MCP server (used by context-bridge skill)
GITHUB_TOKEN=

# Linear MCP server (used by context-bridge skill)
LINEAR_API_KEY=

# Slack MCP server (used by context-bridge skill)
SLACK_BOT_TOKEN=
