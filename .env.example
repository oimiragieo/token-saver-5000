# Token Saver 5000 — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── MCP Server Profile ───────────────────────────────────────────────────────
# Select tool set to expose: "full" (all tools) or "core_stable" (7 essential tools)
MCP_TOOL_PROFILE=full

# ─── Embedding Model Loading ──────────────────────────────────────────────────
# Set to "true" to preload the CodeBERT model at startup (~400MB) instead of lazy loading.
# Default: false (lazy load on first use, saves ~400MB startup memory)
PRELOAD_CODE_MODEL=false

# ─── HTTP Server ──────────────────────────────────────────────────────────────
# Enable the optional aiohttp HTTP server alongside stdio MCP transport.
# Required for Kubernetes health probes. Default: false (stdio-only mode).
HTTP_ENABLED=false
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Health check result caching to avoid expensive checks on every request.
HEALTH_CHECK_CACHE_SECONDS=10

# ─── Environment / Deployment ─────────────────────────────────────────────────
# Affects log verbosity (DEBUG sampling) and OTel sampling rates.
# Values: "development" | "staging" | "production"
ENVIRONMENT=development

# ─── ACE Context Limits ───────────────────────────────────────────────────────
# Maximum number of ACE (Agentic Context Engineering) contexts held in memory.
# Each context is ~70KB. 100 contexts ≈ 7MB. Default: 100
MAX_ACE_CONTEXTS=100

# ─── Document Size Limits ─────────────────────────────────────────────────────
# Maximum document size accepted by ingest tools.
MAX_DOCUMENT_SIZE_MB=10
MAX_TEXT_LENGTH_BYTES=10485760

# ─── OpenTelemetry ────────────────────────────────────────────────────────────
# Trace sampling rate. 1.0 = 100% (development), 0.1 = 10% (production).
OTEL_SAMPLING_RATE=1.0
# Export traces to an OTLP collector (e.g. Jaeger, Grafana Tempo).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Force OTLP export on/off. Values: 1|true|yes|on or 0|false|no|off.
# When unset, OTLP is enabled if OTEL_EXPORTER_OTLP_ENDPOINT is set or ENVIRONMENT=production.
OTEL_ENABLE_OTLP=

# ─── Token Economy / Budgets ──────────────────────────────────────────────────
# Per-session/daily/monthly token limits. 0 = disabled (no limit).
TOKEN_BUDGET_SESSION=0
TOKEN_BUDGET_DAILY=0
TOKEN_BUDGET_MONTHLY=0

# ─── Tee / Recovery (original content preservation) ─────────────────────────
# When to save originals before compression: failures | always | never
TEE_MODE=failures
# In failures mode, tee only when compression exceeds this percent.
TEE_COMPRESSION_THRESHOLD=80.0
TEE_MAX_ENTRIES=50
TEE_MAX_SIZE_MB=100.0

# ─── Tool Result Size Limits ──────────────────────────────────────────────────
# Soft/hard character caps for MCP tool responses; preview length for truncation UI.
TOOL_RESULT_SOFT_LIMIT=40000
TOOL_RESULT_HARD_LIMIT=49000
TOOL_RESULT_PREVIEW=2000

# ─── MIG Selector (multi-granularity compression) ───────────────────────────
MIG_DEFAULT_LAMBDA=0.5
MIG_MIN_CORPUS_TOKENS=10

# ─── Quality Predictor Weights ───────────────────────────────────────────────
# Must sum to ~1.0 for fidelity scoring heuristics.
QUALITY_ENTITY_WEIGHT=0.4
QUALITY_COVERAGE_WEIGHT=0.3
QUALITY_RELEVANCE_WEIGHT=0.3

# ─── Bounded In-Process Registries ───────────────────────────────────────────
MAX_MEMORY_ENTRIES=1000
MAX_PROMPT_TEMPLATES=500
MAX_CONNECTOR_FEEDS=200
MAX_DATASETS=200
MAX_EXPERIMENT_RUNS=1000
MAX_EVIDENCE_BUNDLES=1000
MAX_REPLAY_LOG_ENTRIES=1000

# ─── Compression Graph Tuning ─────────────────────────────────────────────────
SIMILARITY_BLOCK_SIZE=256
MAX_GRAPH_CHUNKS=2500
MAX_DEDUP_NODES=1000
# Override semantic chunk boundary threshold (0.0–1.0). Unset = model-calibrated default.
SEMANTIC_CHUNK_BOUNDARY_THRESHOLD=

# ─── Embeddings / Models ──────────────────────────────────────────────────────
DEFAULT_TEXT_MODEL=BAAI/bge-small-en-v1.5

# ─── Retrieval / Ranking (F11 + rerank) ───────────────────────────────────────
# Path C ranker mode: a (dense) | b (hybrid BM25+RRF). Default: a
F11_RANKER_PATH=a
F11_GATE_IDF_TAU=0.8
F11_GATE_SCORE_FLOOR=5.0
# Cross-encoder rerank: set GOTCONTEXT_RERANK_ENABLED=1 to enable.
GOTCONTEXT_RERANK_ENABLED=0
GOTCONTEXT_RERANK_POOL_SIZE=50
# Structured chunking for code/docs: set GOTCONTEXT_STRUCTURED_CHUNKING=1 to enable.
GOTCONTEXT_STRUCTURED_CHUNKING=0

# ─── Docs / llms.txt ──────────────────────────────────────────────────────────
# Override local path or URL for gotcontext.ai llms.txt (MCP docs tools).
GOTCONTEXT_LLMS_TXT=
GOTCONTEXT_LLMS_TXT_URL=https://gotcontext.ai/llms.txt

# ─── Platform (read-only; do not set unless testing installers) ───────────────
# Windows OS path used by token-saver-install-mcp. Normally set by the OS.
APPDATA=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Requests per second limits for batch and compression endpoints.
RATE_LIMIT_BATCH=10
RATE_LIMIT_COMPRESSION=20
RATE_LIMIT_INGEST=5

# ─── Optional Integrations ────────────────────────────────────────────────────
# GitHub MCP server (used by context-bridge skill)
GITHUB_TOKEN=

# Linear MCP server (used by context-bridge skill)
LINEAR_API_KEY=

# Slack MCP server (used by context-bridge skill)
SLACK_BOT_TOKEN=
